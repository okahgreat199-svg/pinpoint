ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=seatcharter;Username=postgres;Password=postgres
JwtSettings__Key=<openssl rand -base64 48>
# Demo seed accounts (admin@/lecturer@/student1..5@seatcharter.dev) all use this password
Seed__DefaultPassword=<choose one, min 8 chars incl. a digit>
# Required to self-register as a lecturer
Attendance__LecturerInviteCode=<choose one>
# FCM service account: path to the JSON file, or the JSON inline
Firebase__CredentialsPath=
Firebase__CredentialsJson=
# Deep-link QR codes (https://host/c/{token}) + Android App Links
DeepLink__PublicBaseUrl=
DeepLink__AndroidPackageName=com.seatcharter.app
DeepLink__AndroidCertFingerprints__0=
DeepLink__AppDownloadUrl=
# Firebase App Check (Play Integrity). Off in dev so Swagger/curl work; on for the demo host.
AppCheck__Enabled=false
AppCheck__ProjectNumber=
AppCheck__ProjectId=
AppCheck__AppIds__0=
SENTRY_DSN=
LOG_DIRECTORY=
